+    // The stock 5.0.1 desktop client forwards this option unchanged.
+    public int takeEzAdbAudioUid() {
+        if (audioEncoder == null || !audioEncoder.startsWith("ezadb.uid.")) {
+            return -1;
+        }
+        int uid = Integer.parseInt(audioEncoder.substring("ezadb.uid.".length()));
+        if (uid < 0 || uid % 100000 < 10000 || uid % 100000 >= 20000 || audioSource != AudioSource.PLAYBACK || audioDup
+                || newDisplay == null) {
+            throw new IllegalArgumentException("EzAdb app audio requires an app UID and isolated virtual-display playback");
+        }
+        audioEncoder = null;
+        return uid;
+    }
